#!/bin/sh
set -eu
HOST=0.0.0.0
PORT=8080
IFACE=wlan0
ADAPTER=openwrt
while [ "$#" -gt 0 ]; do
	case "$1" in
		--host) HOST="$2"; shift 2;;
		--port) PORT="$2"; shift 2;;
		--interface) IFACE="$2"; shift 2;;
		--adapter) ADAPTER="$2"; shift 2;;
		*) echo "unknown argument: $1" >&2; exit 2;;
	esac
done
/usr/bin/awrf-check
export HOST PORT IFACE ADAPTER HARDWARE_ADAPTER="$ADAPTER"
cd /usr/lib/awrf
exec /usr/bin/node /usr/lib/awrf/server.js --host "$HOST" --port "$PORT" --interface "$IFACE"
