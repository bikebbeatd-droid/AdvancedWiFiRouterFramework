#!/bin/sh
set -eu

HOST=0.0.0.0
PORT=8080
INTERFACE=wlan0
ADAPTER=openwrt

while [ "$#" -gt 0 ]; do
  case "$1" in
    --host) HOST="$2"; shift 2 ;;
    --port) PORT="$2"; shift 2 ;;
    --interface) INTERFACE="$2"; shift 2 ;;
    --adapter) ADAPTER="$2"; shift 2 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

read_secret_file() {
  file="$1"
  [ -f "$file" ] || return 1
  [ "$(stat -c '%a' "$file" 2>/dev/null || echo 0)" = "600" ] || {
    echo "refusing insecure secret file: $file" >&2
    return 1
  }
  tr -d '\r\n' < "$file"
}

if [ -n "${ADMIN_API_TOKEN_FILE:-}" ]; then
  ADMIN_API_TOKEN="$(read_secret_file "$ADMIN_API_TOKEN_FILE")" || {
    echo "AWRF admin token file is missing or not mode 600" >&2
    exit 1
  }
  export ADMIN_API_TOKEN
fi

if [ -n "${CREDENTIAL_STORE_KEY_FILE:-}" ]; then
  CREDENTIAL_STORE_KEY="$(read_secret_file "$CREDENTIAL_STORE_KEY_FILE")" || {
    echo "AWRF credential key file is missing or not mode 600" >&2
    exit 1
  }
  export CREDENTIAL_STORE_KEY
fi

export HOST PORT INTERFACE ADAPTER
export CREDENTIAL_STORE_PATH="${CREDENTIAL_STORE_PATH:-/etc/awrf/credentials.json}"

exec /usr/bin/node /usr/lib/awrf/server.js
