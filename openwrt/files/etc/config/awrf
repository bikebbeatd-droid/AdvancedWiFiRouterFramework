config awrf 'main'
	option enabled '0'
	option bind_host '0.0.0.0'
	option bind_port '8080'
	option wifi_interface 'wlan0'
	option hardware_adapter 'openwrt'
	option auto_reconnect '1'
	option adaptive_channel '1'
	option health_probe_interval_seconds '10'
	option max_reconnect_attempts '3'
	option country 'PK'
